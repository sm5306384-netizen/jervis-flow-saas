from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
import os
from dotenv import load_dotenv
import logging

load_dotenv()

app = FastAPI(
    title="Jervis WhatsApp AI SaaS",
    description="Gym WhatsApp Business Automation with AI",
    version="2.0.0"
)

origins = os.getenv("ALLOWED_ORIGINS", "http://localhost:3000,http://localhost:8000").split(",")

app.add_middleware(
    CORSMiddleware,
    allow_origins=origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

logger = logging.getLogger(__name__)

# Import routes
from app.routes import auth, business, whatsapp, subscription, faq, analytics

# Include routers
app.include_router(auth.router)
app.include_router(business.router)
app.include_router(whatsapp.router)
app.include_router(subscription.router)
app.include_router(faq.router)
app.include_router(analytics.router)

@app.get("/health")
def health_check():
    return {
        "status": "healthy",
        "service": "jervis-whatsapp-ai-saas",
        "version": "2.0.0"
    }

@app.get("/")
def root():
    return {"message": "Jervis WhatsApp AI SaaS Backend Running 🚀"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(
        "main:app",
        host="0.0.0.0",
        port=8000,
        reload=True
    )
